# UI toolchain is separate from the legacy CentOS 7 C++ compiler images.
FROM node:22.23.2-bookworm@sha256:8a34c4ab3ea2c5cd194f07e317b2a8f09461d3c8b05c4e34c8ccd56d56024c4d
# This pinned buildpack image already supplies Python 3.11 and CA certificates.
RUN npm install --global npm@10.9.9 \
    && node --version && npm --version && python3 --version
WORKDIR /workspace/ui
ENV MASSDB_NOTICE_PYTHON=python3
CMD ["sh", "-c", "npm ci && npm run build && npm run check:notices"]
