            "\\bBSD\\b|\\bBSD-\\d",
            "\\b0BSD\\b",
            "Apache",
            "\\bPSF\\b|Python Software Foundation|\\bPython-2\\.0\\b",
            "\\bISC\\b",
            "\\bZlib\\b",
            "Unlicense",
