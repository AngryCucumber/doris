{
    "schemaVersion": 1,
    "description": "Offline Python runtime shipped with MassDB SQL BE for Python UDF/UDAF/UDTF, laid out as a python_env_mode = conda root.",
    "python": {
        "version": "3.12.15",
        "distribution": "python-build-standalone",
        "release": "20261013",
        "urlTemplate": "https://github.com/astral-sh/python-build-standalone/releases/download/{release}/{file}",
        "archives": {
            "aarch64": {
                "file": "cpython-3.12.15+20261013-aarch64-unknown-linux-gnu-install_only.tar.gz",
                "sha256": "34a43010cc05982d8b5debbad7d09f7b1200117ebf018f7acfd656895e408205"
            },
            "x86_64": {
                "file": "cpython-3.12.15+20261013-x86_64-unknown-linux-gnu-install_only.tar.gz",
                "sha256": "5d546fc004fc2435fa142eb8f42ed8de5eb4725963dc22f7e6671014a80eb560"
            }
        }
    },
    "target": {
        "glibc": "2.17",
        "glibcxx": "3.4.19",
        "cxxabi": "1.3.7",
        "minLoadAlign": 65536
    },
    "layout": {
        "rootName": "python-runtime",
        "envName": "python{version}",
        "beConfRoot": "${DORIS_HOME}/lib/python-runtime"
    },
    "indexUrl": "https://pypi.org/simple",
    "layers": [
        {
            "name": "core",
            "purpose": "Required by be/src/udf/python/python_server.py. pyarrow 20.0.0 is the newest release with manylinux2014 (glibc 2.17) aarch64 wheels; its IPC round trips with the BE Arrow 24 (thirdparty/vars.sh) were verified on a live BE.",
            "requirements": ["numpy>=1.26,<3", "pandas>=2.2,<3", "pyarrow==20.0.0"]
        },
        {
            "name": "common",
            "purpose": "Text, time, hashing, encoding and geo helpers commonly used in SQL UDFs.",
            "requirements": [
                "python-dateutil", "pytz", "tzdata", "regex", "orjson", "PyYAML", "charset-normalizer",
                "xxhash", "mmh3", "cryptography", "jieba==0.42.1", "pypinyin", "rapidfuzz", "phonenumbers",
                "shapely", "pyproj", "h3"
            ]
        },
        {
            "name": "analytics",
            "purpose": "Statistics, pandas accelerators and model inference inside UDAF/UDWF.",
            "requirements": [
                "scipy", "scikit-learn", "statsmodels", "numexpr", "bottleneck", "networkx", "sympy", "xgboost",
                "lightgbm"
            ]
        },
        {
            "name": "extended",
            "purpose": "Internal HTTP calls, HTML/XML, Chinese text and calendars, serialization, SM2/SM4 and other crypto, geo/IP/UA parsing, validation.",
            "requirements": [
                "requests", "beautifulsoup4", "lxml", "emoji", "anyascii", "OpenCC", "langdetect==1.0.9", "arrow",
                "cnlunar", "chinesecalendar", "msgpack", "ujson", "simplejson", "protobuf", "gmssl", "pycryptodome",
                "bcrypt", "PyJWT", "geopy", "pygeohash", "ua-parser", "user-agents", "tldextract", "netaddr",
                "maxminddb", "geoip2", "pydantic", "jsonschema", "attrs", "more-itertools", "toolz", "cachetools",
                "email-validator"
            ]
        },
        {
            "name": "engines",
            "purpose": "Embedded dataframe/SQL engines for vectorized UDFs; the largest optional layer.",
            "requirements": ["polars", "duckdb"]
        }
    ],
    "defaultLayers": ["core", "common", "analytics", "extended", "engines"],
    "pureSdists": ["jieba==0.42.1", "langdetect==1.0.9"],
    "requiredImports": ["numpy", "pandas", "pyarrow", "pyarrow.flight", "pip"],
    "importSkip": {
        "adbc_driver_duckdb": "duckdb's ADBC driver shim needs the optional adbc-driver-manager package; UDFs use the duckdb module"
    },
    "licensePolicy": {
        "deny": [
            "\\bA?GPL(?:v?\\d|-\\d|\\b)(?!.*exception)",
            "GNU (?:Affero )?General Public License",
            "\\bSSPL\\b",
            "Commons Clause",
            "\\bBUSL\\b|Business Source License"
        ],
        "review": [
            "\\bLGPL",
            "GNU Lesser General Public License",
            "GNU Library",
            "\\bMPL\\b|Mozilla Public License",
            "\\bEPL\\b|Eclipse Public License",
            "\\bCDDL\\b",
            "\\bCC-BY",
            "Public Domain",
            "Other/Proprietary"
        ],
        "allow": [
